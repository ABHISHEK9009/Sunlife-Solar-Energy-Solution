generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["sunlife"]
}

model Lead {
  id                 String   @id @default(cuid())
  name               String
  phone              String
  email              String?
  city               String?  @default("Narmadapuram")
  propertyType       String?  @default("Residential")
  monthlyBill        String?
  interestedSolution String?
  rooftopArea        String?
  message            String?
  source             String?  @default("Website Quote Form")
  status             String   @default("NEW") // NEW, CONTACTED, SITE_SURVEY_SCHEDULED, QUOTED, WON, LOST
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@schema("sunlife")
}

model ContactInquiry {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  city        String?
  monthlyBill String?
  requirement String?
  message     String?
  createdAt   DateTime @default(now())

  @@schema("sunlife")
}

model CalculatorEstimate {
  id                  String   @id @default(cuid())
  monthlyBill         Float
  propertyType        String
  systemSizeKw        Float
  annualGenerationKwh Float
  annualSavingsInr    Float
  paybackYears        Float
  co2OffsetTons       Float
  name                String?
  phone               String?
  city                String?
  createdAt           DateTime @default(now())

  @@schema("sunlife")
}

model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String   // Residential, Commercial, Industrial, Rooftop
  location      String
  capacityKw    Float
  description   String
  imageUrl      String
  isFeatured    Boolean  @default(false)
  completedDate String?
  createdAt     DateTime @default(now())

  @@schema("sunlife")
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String
  content         String
  coverImage      String?
  author          String   @default("Rahul Kumar Bamne")
  readTimeMinutes Int      @default(5)
  category        String   @default("Solar Guide")
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("sunlife")
}

model TeamMember {
  id               String       @id
  name             String
  role             String
  category         String
  phone            String
  territory        String
  status           String       @default("Available")
  skills           Json         @default("[]")
  joinedYear       String
  monthlySalary    Float?
  email            String?
  dob              String?
  address          String?
  department       String?
  joiningDate      String?
  employmentType   String?
  reportingManager String?
  bankAccountHolder String?
  bankName         String?
  bankAccountNumber String?
  bankIFSC         String?
  bankBranch       String?
  bankAccountType  String?
  upiId            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attendance       Attendance[]
  payrollProfile   PayrollProfile?
  advances         EmployeeAdvance[]
  monthlyPayroll   MonthlyPayroll[]
  leaveRequests    LeaveRequest[]

  @@schema("sunlife")
}

model Attendance {
  id           String     @id @default(cuid())
  memberId     String
  date         DateTime   @db.Date
  status       String     @default("Present")
  checkIn      String     @default("--")
  checkOut     String     @default("--")
  workingMinutes Int       @default(0)
  assignedSite String
  remarks      String?
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())
  member       TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([date])
  @@schema("sunlife")
}

model PayrollProfile {
  id              String     @id @default(cuid())
  memberId        String     @unique
  baseAmount      Float
  fieldAllowance  Float      @default(0)
  paymentStatus   String     @default("PENDING")
  paymentMode     String     @default("Bank Transfer")
  member          TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@schema("sunlife")
}

model EmployeeAdvance {
  id                      String     @id
  memberId                String
  advanceAmount           Float
  advanceDate             String
  reason                  String
  monthlyDeduction        Float
  totalRecovered          Float      @default(0)
  outstandingBalance      Float
  recoveryStatus          String     @default("Active")
  startMonth              String
  expectedCompletionMonth String
  notes                   String?
  settlements             Json       @default("[]")
  member                  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([memberId])
  @@schema("sunlife")
}

model MonthlyPayroll {
  id                         String     @id
  memberId                   String
  month                      String
  monthlySalary              Float
  totalDaysInMonth           Int
  payableDays                Float
  payableSalary              Float
  fieldAllowance             Float
  advanceOutstanding         Float
  scheduledAdvanceDeduction  Float
  otherDeductions            Float
  otherDeductionNote         String?
  netPayable                 Float
  advanceSettlementType      String?
  advanceSettlementAmount    Float?
  advanceNotSettledReason    String?
  paymentStatus              String     @default("PENDING")
  paymentDate                String?
  paymentMode                String?
  paidAt                     String?
  member                     TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  @@unique([memberId, month])
  @@schema("sunlife")
}

model LeaveRequest {
  id          String     @id @default(cuid())
  memberId    String
  startDate   String
  endDate     String
  leaveType   String
  reason      String
  status      String     @default("PENDING")
  reviewedBy  String?
  reviewedAt  DateTime?
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([memberId, status])
  @@schema("sunlife")
}
