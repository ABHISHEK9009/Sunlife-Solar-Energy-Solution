# ═══════════════════════════════════════════════════════════════════════════════
#   SUNLIFE SOLAR CRM — Environment Variables Template (For Vercel & Local)
#   Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Neon PostgreSQL (Production) — Schema: sunlife
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&schema=sunlife"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require&schema=sunlife"

# ─── APPLICATION ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://sunlifesolar.in"
NEXT_PUBLIC_PHONE="7722995100"
NEXT_PUBLIC_WHATSAPP="7722995100"
NEXT_PUBLIC_OWNER_NAME="Rahul Kumar Bamne"

# ─── ADMIN CREDENTIALS ───────────────────────────────────────────────────────
ADMIN_EMAIL="your_admin_email@example.com"
ADMIN_PASSWORD="your_admin_password_here"

# ─── AUTH / JWT SECRETS ───────────────────────────────────────────────────────
AUTH_JWT_SECRET="generate_a_random_secret_here"
CUSTOMER_AUTH_SECRET="optional_customer_secret"
AGENT_AUTH_SECRET="optional_agent_secret"

# ─── GOOGLE OAUTH & DRIVE STORAGE ────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"
GOOGLE_DRIVE_REFRESH_TOKEN="your_google_drive_refresh_token"

# ─── EMAIL / SMTP ─────────────────────────────────────────────────────────────
# Gmail SMTP — Generate app password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_gmail_app_password"
SMTP_FROM="Your Name <your_email@gmail.com>"
CONTACT_NOTIFICATION_EMAIL="your_email@gmail.com"

# ─── SMS SERVICE (Optional) ──────────────────────────────────────────────────
# FAST2SMS_API_KEY="your_fast2sms_key"
# TWILIO_ACCOUNT_SID="your_twilio_sid"
# TWILIO_AUTH_TOKEN="your_twilio_token"
# TWILIO_PHONE_NUMBER="+1234567890"

# ─── WHATSAPP GATEWAY (Point to your Railway URL in Production) ───────────────
# Local: http://localhost:3001
# Production: https://<your-railway-app>.up.railway.app
WHATSAPP_GATEWAY_URL="http://localhost:3001"
WHATSAPP_API_KEY="your_whatsapp_api_key"
CRM_WEBHOOK_SECRET="your_webhook_secret"
